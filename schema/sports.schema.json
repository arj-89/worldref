{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arj-89.github.io/worldref/schema/sports.schema.json",
  "title": "worldref sports",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "iso2",
      "sports"
    ],
    "properties": {
      "iso2": {
        "description": "ISO 3166-1 alpha-2 code (XK for Kosovo). The key that joins every module.",
        "type": "string"
      },
      "sports": {
        "description": "Sports codes.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fifa",
          "ioc"
        ],
        "properties": {
          "fifa": {
            "description": "FIFA country code.",
            "type": [
              "string",
              "null"
            ]
          },
          "ioc": {
            "description": "IOC country code.",
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
